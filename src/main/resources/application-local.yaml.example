# 本地开发配置模板：复制为 application-local.yaml 后填真实值（该文件已 gitignore，永不入库）。
# cp src/main/resources/application-local.yaml.example src/main/resources/application-local.yaml
# 启动：java -jar target/Nlp2dsl2sql-0.0.1-SNAPSHOT.jar --spring.profiles.active=local
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/agent_db?options=-c%20search_path%3Dagent%2Cpublic
    username: agent_user
    password: CHANGE_ME_DB_PASSWORD

agentscope:
  openai:
    api-key: CHANGE_ME_LLM_API_KEY
    base-url: https://api.deepseek.com
    model-name: deepseek-flash

a2a:
  host:
    model:
      tiers:
        fast:
          api-key: CHANGE_ME_LLM_API_KEY
        strong:
          api-key: CHANGE_ME_LLM_API_KEY

# 对外暴露的 /aiChat/* 接口网关（与过滤器对应，local 可设简单值，生产用强随机串走环境变量 AI_API_KEY）
ai:
  api-key: CHANGE_ME_AI_API_KEY

cors:
  allowed-origins: http://localhost:8079
