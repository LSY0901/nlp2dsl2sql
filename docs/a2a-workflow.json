    "quality_profile": "showcase",
    "views": [
      {
        "id": "full-flow",
        "label": "主链路：查数+规范综合",
        "focus": ["user_req", "model_router", "host_agent", "sql_prep", "hitl_gate", "sql_db", "sop_agent", "flux_merge", "final_stream"],
        "note": "完整端到端时序：用户提问经分层路由与意图拆解，串行先SQL查数、HITL审批、再调SOP，最后三路流汇聚输出。"
      },
      {
        "id": "hitl-gate-view",
        "label": "SQL HITL 审批防线",
        "focus": ["sql_prep", "hitl_gate", "sql_db"],
        "note": "拦截 execute_sql 动作，经 SSE 桥透传待审 SQL，由用户输入 yes/确认 放行执行。"
      },
      {
        "id": "sop-stream-view",
        "label": "SOP调用与流汇聚",
        "focus": ["sql_db", "sop_agent", "flux_merge", "final_stream"],
        "note": "SQL 完成后串行通过 A2aAgent.call 请求远端 SOP Server，结果统一汇入 Flux.merge 实时推流。"
      }
    ],
    "output": "docs/a2a-workflow.html"
  },
  "lanes": [
