    { "id": "e_sub1", "from": "host_agent", "to": "sql_prep", "label": "派发查数", "variant": "emphasis" },
    { "id": "e_ask", "from": "sql_prep", "to": "hitl_gate", "label": "请求审批", "variant": "security" },
    { "id": "e_approved", "from": "hitl_gate", "to": "sql_db", "label": "批准执行", "variant": "emphasis" },
    { "id": "e_sub2", "from": "sql_db", "to": "sop_agent", "label": "派发SOP", "variant": "emphasis" },
    { "id": "e_sop_done", "from": "sop_agent", "to": "flux_merge", "label": "SOP结果", "variant": "default" },
    { "id": "e_sql_done", "from": "sql_db", "to": "flux_merge", "label": "SQL结果", "variant": "dashed" },
    { "id": "e_stream", "from": "flux_merge", "to": "final_stream", "label": "SSE推送", "variant": "emphasis", "role": "return" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "A2A 核心协作准则",
      "items": [
        "串行调度：Host Agent 严格先调 call_sql_agent，后调 call_sop_agent",
        "HITL 防线：在真正落库执行 SQL 前拦截 execute_sql，等待用户确认输入",
        "流式合并：head 首包元数据、Host 主推理、SQL 过程流统一经 Flux.merge 实时穿透"
      ]
    },
    {
      "dot": "emerald",
      "title": "容错与降级设计",
      "items": [
        "用户拒绝或 5 分钟超时取消 SQL，子查询安全熔断并降级继续执行 SOP",
        "SOP 远端异常时明确告知失败项，仍基于 SQL 成功数据生成完整回答"
      ]
    }
  ]
}
